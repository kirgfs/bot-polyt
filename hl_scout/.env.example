# Скопируйте в .env и заполните. Файл .env не коммитится.
# hl_scout не нужны приватные ключи и API-ключи Hyperliquid: только публичный Info API.

# Telegram (нужен на следующем этапе — сообщения СЛЕДИТЬ / ВНИМАНИЕ / ПРЕКРАТИТЬ)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Необязательно: другие пути к конфигам
# HL_SCOUT_CONFIG=config.yaml
# HL_SCOUT_COPYBOT=copybot_fields.yaml
