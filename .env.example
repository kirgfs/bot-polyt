# Скопируйте в .env и заполните. Файл .env не коммитится.
# Имена переменных — черновик M0; окончательный список фиксируется в src/core/config.py на M1.

# --- Режим ---------------------------------------------------------------
# paper | shadow | live
MODE=paper
# Реальные ордера запрещены, пока здесь не true И запуск не подтверждён в чате.
LIVE_TRADING=false

# --- Polymarket (нужно только с Live-S; рекордеру не требуется) -----------
# Отдельный торговый кошелёк только под бота. Ключ никогда не логируется.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# Тип подписи (см. docs/api_notes.md §4)
POLYMARKET_SIGNATURE_TYPE=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
# Верхний предел депозита торгового кошелька, pUSD
MAX_DEPOSIT_PUSD=500

# --- Коэффициенты (docs/data_sources.md) ---------------------------------
# betfair | oddspapi | the_odds_api
ODDS_PROVIDER=oddspapi
ODDSPAPI_API_KEY=
THE_ODDS_API_KEY=
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_PATH=

# --- Счёт (лайв, M7) -----------------------------------------------------
# polymarket_sports | sportradar | livetennisapi | tennis_api
SCORES_PROVIDER=polymarket_sports
TENNIS_FEED_API_KEY=

# --- Telegram ------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Через запятую; команды принимаются только из этих чатов
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Хранилище и логи ----------------------------------------------------
DATA_DIR=./data
SQLITE_PATH=./data/state.sqlite
LOG_LEVEL=INFO
