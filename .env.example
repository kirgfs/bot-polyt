# Скопируйте в .env и заполните. Файл .env не коммитится (.gitignore).
# Переменные читает src/polybot/core/config.py (Settings); всё остальное — config/*.yaml.

# --- Режим ---------------------------------------------------------------
# paper | shadow | live
MODE=paper
# Реальные ордера запрещены, пока здесь не true И запуск не подтверждён в чате.
LIVE_TRADING=false

# --- Polymarket (нужно только с Live-S; рекордеру M1 не требуется) --------
# Отдельный торговый кошелёк только под бота. Ключ никогда не логируется.
POLYMARKET_PRIVATE_KEY=
POLYMARKET_FUNDER_ADDRESS=
# Тип подписи (см. docs/api_notes.md §4)
POLYMARKET_SIGNATURE_TYPE=
CLOB_API_KEY=
CLOB_SECRET=
CLOB_PASSPHRASE=
# Верхний предел депозита торгового кошелька, pUSD
MAX_DEPOSIT_PUSD=500

# --- Коэффициенты (docs/data_sources.md) ---------------------------------
# OddsPapi: ключ free/trial. Передаётся только query-параметром apiKey, в логи и Parquet не попадает.
ODDSPAPI_API_KEY=
# The Odds API отложен до проверки OddsPapi (решение 2026-09-25); Betfair не используем.

# --- Счёт (лайв, M7) -----------------------------------------------------
# polymarket_sports | <платный фид — только по решению 5, docs/data_sources.md §0>
SCORES_PROVIDER=polymarket_sports
TENNIS_FEED_API_KEY=

# --- Telegram (M4) -------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Через запятую; команды принимаются только из этих чатов
TELEGRAM_ALLOWED_CHAT_IDS=

# --- Хранилище и логи ----------------------------------------------------
DATA_DIR=./data
CONFIG_DIR=./config
LOG_LEVEL=INFO
# json | console
LOG_FORMAT=json

# --- Docker: потолок памяти контейнеров (docker-compose.yml) --------------
# Рекордер в работе занимает ~150–200 МБ. Сумма двух лимитов должна быть меньше RAM
# сервера минус ~300 МБ на систему. Превышение — контейнер перезапускается, хост цел.
RECORDER_MEM_LIMIT=400m
TOOLS_MEM_LIMIT=512m
